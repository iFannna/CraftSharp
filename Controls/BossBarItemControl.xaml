<UserControl x:Class="CraftSharp.Controls.BossBarItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="Auto" Height="Auto">

    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,4,0,4"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
            x:Name="RootBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：排序图标 -->
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0"
                        Cursor="Hand" MouseLeftButtonDown="OnDragHandleClick">
                <Path Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill" Width="16" Height="2" Margin="0,2"
                      Data="M0,0 L16,0 L16,2 L0,2 Z"/>
                <Path Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill" Width="16" Height="2" Margin="0,2"
                      Data="M0,0 L16,0 L16,2 L0,2 Z"/>
                <Path Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill" Width="16" Height="2" Margin="0,2"
                      Data="M0,0 L16,0 L16,2 L0,2 Z"/>
            </StackPanel>

            <!-- 中间：BOSS图标预览 + 名称 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- BOSS血条图标预览（182x5比例，缩放显示） -->
                <Border Width="364" Height="10" Margin="0,0,12,0"
                        
                        x:Name="IconPreviewBorder">
                    <Image x:Name="IconPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <!-- BOSS名称 -->
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 右侧：编辑按钮（链接样式） -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                <Hyperlink x:Name="EditLink"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextDecorations="None"
                           Cursor="Hand"
                           Click="EditLink_Click">
                    <Run Text="{DynamicResource BossBarItemEdit}"/>
                </Hyperlink>
            </TextBlock>

            <!-- 右侧：启用按钮（链接样式） -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="4,0">
                <Hyperlink x:Name="EnableLink"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextDecorations="None"
                           Cursor="Hand"
                           Click="EnableLink_Click">
                    <Run x:Name="EnableRun" Text="{DynamicResource BossBarItemEnable}"/>
                </Hyperlink>
            </TextBlock>

            <!-- 右侧：删除按钮（链接样式） -->
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="4,0">
                <Hyperlink x:Name="DeleteLink"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextDecorations="None"
                           Cursor="Hand"
                           Click="DeleteLink_Click">
                    <Run Text="{DynamicResource BossBarItemDelete}"/>
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>