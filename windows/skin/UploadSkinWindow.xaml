<ui:FluentWindow x:Class="CraftSharp.Windows.Skin.UploadSkinWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:components="clr-namespace:CraftSharp.Windows.Settings.Panels.Skin.Components"
                 Title="{DynamicResource UploadSkinTitle}"
                 Width="600" Height="450"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource UploadSkinTitle}" ShowMinimize="False" ShowMaximize="False"
                     FontSize="{DynamicResource GlobalFontSize}" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.45*"/>
                <ColumnDefinition Width="0.55*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧表单区域 -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <!-- 材质名称输入框 -->
                <TextBlock Text="{DynamicResource UploadSkinNameLabel}" FontSize="{DynamicResource GlobalFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ui:TextBox x:Name="NameTextBox"
                            PlaceholderText="{DynamicResource UploadSkinNamePlaceholder}"
                            TextChanged="NameTextBox_TextChanged"/>
                <!-- 验证提示 -->
                <TextBlock x:Name="ValidationErrorText"
                           Text=""
                           FontSize="{DynamicResource GlobalFontSizeCaption}"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>

                <!-- 材质类型选择 -->
                <TextBlock Text="{DynamicResource UploadSkinTypeLabel}" FontSize="{DynamicResource GlobalFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioSteve" Content="Steve" IsChecked="True" Margin="0,0,16,0"/>
                    <RadioButton x:Name="RadioAlex" Content="Alex"/>
                </StackPanel>

                <!-- 选择文件按钮 -->
                <TextBlock Text="{DynamicResource UploadSkinFileLabel}" FontSize="{DynamicResource GlobalFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8"/>
                <ui:Button x:Name="SelectFileButton"
                           Appearance="Secondary"
                           Content="{DynamicResource UploadSkinSelectFile}"
                           Click="SelectFileButton_Click"/>
                <!-- 文件名显示 -->
                <TextBlock x:Name="FileNameText"
                           Text=""
                           FontSize="{DynamicResource GlobalFontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 右侧预览区域 -->
            <Border Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                <components:SkinPreviewControl x:Name="SkinPreview"/>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,16">
            <ui:Button Appearance="Secondary" Content="{DynamicResource UploadSkinCancel}" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <ui:Button x:Name="ConfirmButton" Appearance="Primary" Content="{DynamicResource UploadSkinConfirm}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>