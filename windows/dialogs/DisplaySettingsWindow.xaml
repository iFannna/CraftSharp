<ui:FluentWindow x:Class="CraftSharp.Windows.Dialogs.DisplaySettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:helpers="clr-namespace:CraftSharp.Helpers"
                 Title="{DynamicResource DisplaySettingsTitle}"
                 Width="1080" Height="720"
                 MinWidth="800" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Loaded="Window_Loaded"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <ui:FluentWindow.Resources>
        <!-- 显示器位置图块：纯色块+编号；描边走 KeyboardAccessibility.ShowFocusVisual（仅键盘输入获得焦点时显示），
             画在块自身 2px 边框上尺寸不变，鼠标点击选中不出描边、无原生焦点虚线框 -->
        <Style x:Key="MonitorBlockStyle" TargetType="Button">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BlockBd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="2" BorderBrush="{DynamicResource CardBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="{x:Static helpers:KeyboardAccessibility.ShowFocusVisualProperty}" Value="True">
                                <Setter TargetName="BlockBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource DisplaySettingsTitle}" ShowMinimize="False" ShowMaximize="True" ShowClose="True"
                     FontSize="{DynamicResource GlobalFontSize}" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">

                    <!-- 显示器位置图 -->
                    <Border x:Name="DiagramCard" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12"
                            SizeChanged="DiagramCard_SizeChanged">
                        <StackPanel>
                            <Canvas x:Name="MonitorCanvas" Height="260" Width="10" HorizontalAlignment="Center"/>
                            <Grid Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Content="{DynamicResource DisplayIdentify}"
                                               Appearance="Secondary" Padding="16,6" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Click="Identify_Click"/>
                                    <ComboBox x:Name="ModeCombo" Width="160"
                                              IsHitTestVisible="False" Focusable="False"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 缩放和布局 -->
                    <TextBlock Text="{DynamicResource DisplayScaleLayoutSection}" FontWeight="SemiBold"
                               FontSize="{DynamicResource GlobalFontSize}" Margin="2,16,0,8"/>
                    <StackPanel>
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource DisplayScale}" FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource DisplayScaleDesc}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="ScaleCombo" Grid.Column="1" Width="160"
                                          IsHitTestVisible="False" Focusable="False"/>
                            </Grid>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource DisplayResolution}" FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource DisplayResolutionDesc}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="ResolutionCombo" Grid.Column="1" Width="160"
                                          IsHitTestVisible="False" Focusable="False"/>
                            </Grid>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource DisplayOrientation}" FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox x:Name="OrientationCombo" Grid.Column="1" Width="160"
                                          IsHitTestVisible="False" Focusable="False"/>
                            </Grid>
                        </ui:Card>
                    </StackPanel>

                    <!-- 壁纸应用 -->
                    <TextBlock Text="{DynamicResource DisplayApplySection}" FontWeight="SemiBold"
                               FontSize="{DynamicResource GlobalFontSize}" Margin="2,16,0,8"/>
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="144" Height="90" CornerRadius="6" Background="#33808080" ClipToBounds="True">
                                    <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="WallpaperTitleText" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ui:Button x:Name="ModeIndependentButton" Content="{DynamicResource WallpaperModeIndependent}" Tag="independent"
                                                   Appearance="Primary" Margin="0,0,4,0" Padding="16,6" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                                   Click="ModeButton_Click"/>
                                        <ui:Button x:Name="ModeSpanButton" Content="{DynamicResource WallpaperModeSpan}" Tag="span"
                                                   Appearance="Secondary" Padding="16,6" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                                   Click="ModeButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource DisplayApplyTargets}" Margin="0,12,0,6"
                                       FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <WrapPanel x:Name="MonitorChipPanel"/>
                            <ui:Button x:Name="ApplyButton" Content="{DynamicResource WallpaperQuickSet}" Appearance="Primary"
                                       Padding="24,8" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                       HorizontalAlignment="Right" Margin="0,12,0,0" Click="Apply_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
