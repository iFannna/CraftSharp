<ui:FluentWindow x:Class="CraftSharp.Windows.Dialogs.StylePreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource StylePreviewTitle}"
                 Height="400" Width="500"
                 MinHeight="300" MinWidth="400"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource StylePreviewTitle}" ShowMinimize="False" ShowMaximize="False" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 图片预览区域 -->
        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左箭头 -->
            <Button x:Name="PrevButton" Grid.Column="0"
                    Width="32" Height="32"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Click="PrevButton_Click">
                <Path Data="M 6 0 L 0 6 L 6 12"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="2"
                      Width="10" Height="12"
                      Stretch="Uniform"/>
            </Button>

            <!-- 图片容器 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Viewbox x:Name="ImageViewbox"
                         Stretch="Uniform"
                         MaxWidth="400" MaxHeight="280">
                    <Image x:Name="StyleImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Cursor="Hand"
                           MouseLeftButtonDown="StyleImage_Click"/>
                </Viewbox>
            </Border>

            <!-- 右箭头 -->
            <Button x:Name="NextButton" Grid.Column="2"
                    Width="32" Height="32"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Click="NextButton_Click">
                <Path Data="M 0 0 L 6 6 L 0 12"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="2"
                      Width="10" Height="12"
                      Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- 图片序号 -->
        <TextBlock x:Name="IndexText" Grid.Row="2"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,8"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 当前样式名称 -->
        <TextBlock x:Name="StyleNameText" Grid.Row="3"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"
                   FontSize="16" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
    </Grid>
</ui:FluentWindow>