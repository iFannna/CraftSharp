<UserControl x:Class="CraftSharp.Windows.Settings.Panels.About.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- 底部小号链接按钮：默认次级色，hover/键盘焦点时变强调色 -->
        <Style x:Key="FooterLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeCaption}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource AboutPanelTitle}" FontSize="{DynamicResource GlobalFontSizeTitle}" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <ui:Card Padding="24">
            <StackPanel>
                <!-- Logo and Title -->
                <StackPanel Margin="0,0,0,16" VerticalAlignment="Center">
                    <TextBlock Text="Craft#" FontSize="{DynamicResource GlobalFontSizeTitleXL}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource GlobalFontSize}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource AboutDesc}" Margin="0,0,0,24"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Separator Margin="0,0,0,16" Background="{DynamicResource DividerBrush}"/>

                <!-- Info Grid -->
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutAuthor}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="iFannna" HorizontalAlignment="Right"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="AuthorLink_Click"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutLicense}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="MIT License" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutProjectUrl}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="GitHub" HorizontalAlignment="Right"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="GitHubLink_Click"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutCopyright}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="© 2025 iFannna" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <Separator Margin="0,0,0,16" Background="{DynamicResource DividerBrush}"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Appearance="Secondary" Content="{DynamicResource AboutCheckUpdate}" Click="CheckUpdate_Click" Width="120"/>
                    <ui:Button Appearance="Secondary" Content="{DynamicResource AboutFeedback}" Margin="16,0,0,0" Click="Feedback_Click" Width="120"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="{DynamicResource AboutTerms}" Margin="0,0,16,0"
                    Style="{StaticResource FooterLinkStyle}"
                    Click="Terms_Click"/>
            <Button Content="{DynamicResource AboutPrivacy}"
                    Style="{StaticResource FooterLinkStyle}"
                    Click="Privacy_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>