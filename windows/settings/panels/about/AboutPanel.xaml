<UserControl x:Class="CraftSharp.Windows.Settings.Panels.About.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource AboutPanelTitle}" FontSize="{DynamicResource GlobalFontSizeTitle}" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <ui:Card Padding="24">
            <StackPanel>
                <!-- Logo and Title -->
                <StackPanel Margin="0,0,0,16" VerticalAlignment="Center">
                    <TextBlock Text="Craft#" FontSize="{DynamicResource GlobalFontSizeTitleXL}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource GlobalFontSize}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource AboutDesc}" Margin="0,0,0,24"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Separator Margin="0,0,0,16" Background="{DynamicResource DividerBrush}"/>

                <!-- Info Grid -->
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutAuthor}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Cursor="Hand"
                                MouseLeftButtonDown="AuthorLink_Click">
                        <TextBlock Text="iFannna" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutLicense}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="MIT License" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutProjectUrl}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Cursor="Hand"
                                MouseLeftButtonDown="GitHubLink_Click">
                        <TextBlock Text="GitHub" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource AboutCopyright}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="© 2025 iFannna" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <Separator Margin="0,0,0,16" Background="{DynamicResource DividerBrush}"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Appearance="Secondary" Content="{DynamicResource AboutCheckUpdate}" Click="CheckUpdate_Click" Width="120"/>
                    <ui:Button Appearance="Secondary" Content="{DynamicResource AboutFeedback}" Margin="16,0,0,0" Click="Feedback_Click" Width="120"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource AboutTerms}"
                       FontSize="{DynamicResource GlobalFontSizeCaption}" Cursor="Hand" Margin="0,0,16,0"
                       TextDecorations="Underline"
                       MouseLeftButtonDown="Terms_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{DynamicResource AboutPrivacy}"
                       FontSize="{DynamicResource GlobalFontSizeCaption}" Cursor="Hand"
                       TextDecorations="Underline"
                       MouseLeftButtonDown="Privacy_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>