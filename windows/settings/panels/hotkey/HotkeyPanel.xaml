<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Hotkey.HotkeyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource HotkeyPanelTitle}" FontSize="{DynamicResource GlobalFontSizeTitle}" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Text="{DynamicResource HotkeyGlobalHotkeys}" FontSize="{DynamicResource GlobalFontSizeSection}" FontWeight="Medium" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 显示桌面图标 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyDesktopIconsLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeyDesktopIconsDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="Ctrl+Alt+D"
                               x:Name="DesktopIconsHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="DesktopIcons"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="DesktopIconsClearBtn" Click="ClearHotkey_Click" Tag="DesktopIcons"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 打开设置面板 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeySettingsLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeySettingsDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="Ctrl+Alt+S"
                               x:Name="SettingsHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="Settings"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="SettingsClearBtn" Click="ClearHotkey_Click" Tag="Settings"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 打开物品栏 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyInventoryLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeyInventoryDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="Ctrl+Alt+E"
                               x:Name="InventoryHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="Inventory"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="InventoryClearBtn" Click="ClearHotkey_Click" Tag="Inventory"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 打开状态栏 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyStatusBarLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeyStatusBarDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="Ctrl+Alt+H"
                               x:Name="StatusBarHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="StatusBar"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="StatusBarClearBtn" Click="ClearHotkey_Click" Tag="StatusBar"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 打开准星 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyCrosshairLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeyCrosshairDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="Ctrl+Alt+C"
                               x:Name="CrosshairHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="Crosshair"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="CrosshairClearBtn" Click="ClearHotkey_Click" Tag="Crosshair"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <TextBlock Text="{DynamicResource HotkeyLocalHotkeys}" FontSize="{DynamicResource GlobalFontSizeSection}" FontWeight="Medium" Margin="0,24,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 丢弃物品 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyDropItemLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeyDropItemDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="Q"
                               x:Name="DropItemHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="DropItem"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="DropItemClearBtn" Click="ClearHotkey_Click" Tag="DropItem"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 打开物品栏 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyOpenInventoryLabel}" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource HotkeyOpenInventoryDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" MinWidth="120" Padding="16,8" Content="E"
                               x:Name="OpenInventoryHotkeyBtn" Click="HotkeyButton_Click"
                               Tag="OpenInventory"/>
                    <ui:Button Appearance="Secondary" Padding="12,8" Margin="6,0,0,0"
                               x:Name="OpenInventoryClearBtn" Click="ClearHotkey_Click" Tag="OpenInventory"
                               Content="✕" ToolTip="{DynamicResource HotkeyClearTooltip}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 恢复默认按钮 -->
        <Grid Margin="0,24,0,0">
            <ui:Button HorizontalAlignment="Right" Appearance="Secondary"
                       x:Name="RestoreDefaultsBtn" Click="RestoreDefaultsBtn_Click"
                       Content="{DynamicResource RestoreDefaults}"/>
        </Grid>
    </StackPanel>
</UserControl>
