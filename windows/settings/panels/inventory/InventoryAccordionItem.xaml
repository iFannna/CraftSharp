<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Inventory.InventoryAccordionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,0,0,8">
        <!-- Header -->
        <Border x:Name="HeaderBorder"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16"
                MouseLeftButtonDown="Header_Click"
                Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <Path x:Name="ArrowPath" Grid.Column="1"
                      Data="M 0 0 L 4 4 L 8 0"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeThickness="2"
                      Width="12" Height="8"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ArrowRotate" Angle="-90"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Border>

        <!-- Content -->
        <Border x:Name="ContentBorder" Margin="0,8,0,0"
                Height="0" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16">
            <StackPanel x:Name="ContentPanel"/>
        </Border>
    </StackPanel>
</UserControl>