<ui:FluentWindow x:Class="CraftSharp.Windows.Settings.Panels.Wallpaper.WallpaperPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource WallpaperPreviewTitle}"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="CanResize"
                 ShowInTaskbar="True"
                 Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource WallpaperPreviewTitle}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     FontSize="{DynamicResource GlobalFontSize}" FontWeight="Medium"
                     Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 图片预览区 -->
        <Grid Grid.Row="1" x:Name="RootGrid"
              ClipToBounds="True"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
              MouseWheel="RootGrid_MouseWheel">

            <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True"
                             Width="40" Height="40" Opacity="0.6"
                             Panel.ZIndex="0"/>
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- 上一张 -->
            <Button x:Name="PrevBtn" Panel.ZIndex="1"
                    Width="40" Height="40" Margin="12,0,0,0"
                    VerticalAlignment="Center" HorizontalAlignment="Left"
                    Cursor="Hand"
                    AutomationProperties.Name="{DynamicResource WallpaperPreviewPrev}"
                    ToolTip="{DynamicResource WallpaperPreviewPrev}"
                    Click="PrevBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#80A0A0A0"
                                BorderBrush="#A0A0A0A0" BorderThickness="1"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A0A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="26" Foreground="White"/>
            </Button>

            <!-- 下一张 -->
            <Button x:Name="NextBtn" Panel.ZIndex="1"
                    Width="40" Height="40" Margin="0,0,12,0"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Cursor="Hand"
                    AutomationProperties.Name="{DynamicResource WallpaperPreviewNext}"
                    ToolTip="{DynamicResource WallpaperPreviewNext}"
                    Click="NextBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#80A0A0A0"
                                BorderBrush="#A0A0A0A0" BorderThickness="1"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A0A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <ui:SymbolIcon Symbol="ChevronRight20" FontSize="26" Foreground="White"/>
            </Button>
        </Grid>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}">
            <TextBlock x:Name="ResolutionText" VerticalAlignment="Center"
                       Margin="16,0,0,0" FontSize="{DynamicResource GlobalFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,8,0,12">
                <!-- 缩小 -->
                <ui:Button x:Name="ZoomOutBtn" Margin="0,0,4,0" Width="36" Height="36"
                           Appearance="Transparent" Padding="0" BorderThickness="0"
                           AutomationProperties.Name="{DynamicResource WallpaperPreviewZoomOut}"
                           ToolTip="{DynamicResource WallpaperPreviewZoomOut}"
                           Click="ZoomOutBtn_Click">
                    <ui:SymbolIcon Symbol="ZoomOut20" FontSize="26"/>
                </ui:Button>

                <!-- 放大 -->
                <ui:Button x:Name="ZoomInBtn" Margin="0,0,4,0" Width="36" Height="36"
                           Appearance="Transparent" Padding="0" BorderThickness="0"
                           AutomationProperties.Name="{DynamicResource WallpaperPreviewZoomIn}"
                           ToolTip="{DynamicResource WallpaperPreviewZoomIn}"
                           Click="ZoomInBtn_Click">
                    <ui:SymbolIcon Symbol="ZoomIn20" FontSize="26"/>
                </ui:Button>

                <!-- 适应 -->
                <ui:Button x:Name="FitBtn" Margin="0,0,4,0" Width="36" Height="36"
                           Appearance="Transparent" Padding="0" BorderThickness="0"
                           AutomationProperties.Name="{DynamicResource WallpaperPreviewFit}"
                           Click="FitBtn_Click" ToolTip="{DynamicResource WallpaperPreviewFit}">
                    <ui:SymbolIcon Symbol="FullScreenMaximize20" FontSize="26"/>
                </ui:Button>

                <!-- 下载 -->
                <ui:Button x:Name="DownloadBtn" Margin="0,0,4,0" Width="36" Height="36"
                           Appearance="Transparent" Padding="0" BorderThickness="0"
                           AutomationProperties.Name="{DynamicResource WallpaperPreviewDownload}"
                           ToolTip="{DynamicResource WallpaperPreviewDownload}"
                           Click="DownloadBtn_Click">
                    <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="26"/>
                </ui:Button>

                <!-- 分隔线 -->
                <Border Width="1" Margin="8,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                <!-- 设为壁纸 -->
                <ui:Button x:Name="SetWallpaperBtn" Margin="0,0,6,0"
                           Appearance="Primary" Padding="14,6" FontSize="{DynamicResource GlobalFontSizeCaption}"
                           Click="SetWallpaperBtn_Click">
                    <TextBlock Text="{DynamicResource WallpaperSetWallpaper}"/>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
