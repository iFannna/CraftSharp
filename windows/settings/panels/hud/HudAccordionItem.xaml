<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Hud.HudAccordionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,0,0,8">
        <!-- Header（ToggleButton：键盘空格/回车可展开，UIA Toggle 模式） -->
        <ToggleButton x:Name="HeaderToggle"
                      Style="{StaticResource WpfUiExpanderToggleButtonStyle}"
                      FontWeight="Medium"
                      Click="HeaderToggle_Click"/>

        <!-- Content -->
        <Border x:Name="ContentBorder" Margin="0,8,0,0"
                Height="0" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16">
            <StackPanel x:Name="ContentPanel"/>
        </Border>
    </StackPanel>
</UserControl>