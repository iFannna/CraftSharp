<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Skin.SkinPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:CraftSharp.Windows.Settings.Panels.Skin.Components"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- 皮肤类型选项卡样式：Steve/Alex 单选组，Upload 为动作型选项（选中态由代码按需复位） -->
        <Style x:Key="SkinTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="Medium"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部卡片 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧选项按钮 -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SteveOption" GroupName="SkinType" Margin="0,0,8,0"
                                 Style="{StaticResource SkinTabRadioButtonStyle}"
                                 Content="{DynamicResource SkinTabSteve}"
                                 Checked="SkinTypeOption_Checked"/>
                    <RadioButton x:Name="AlexOption" GroupName="SkinType" Margin="0,0,8,0"
                                 Style="{StaticResource SkinTabRadioButtonStyle}"
                                 Content="{DynamicResource SkinTabAlex}"
                                 Checked="SkinTypeOption_Checked"/>
                    <RadioButton x:Name="UploadOption" GroupName="SkinType"
                                 Style="{StaticResource SkinTabRadioButtonStyle}"
                                 Content="{DynamicResource SkinTabUpload}"
                                 Checked="UploadOption_Checked"/>
                </StackPanel>

                <!-- 右侧搜索框 -->
                <ui:TextBox x:Name="SearchBox" Grid.Column="1" Width="180" MinWidth="180" MaxWidth="180" HorizontalAlignment="Right"
                            FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{DynamicResource GlobalFontSize}"
                            PlaceholderText="{DynamicResource SkinSearchPlaceholder}"
                            ClearButtonEnabled="True" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </ui:Card>

        <!-- 左右分栏区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.65*"/>
                <ColumnDefinition Width="0.35*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧卡片 - 皮肤列表 -->
            <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="0" VerticalAlignment="Stretch">
                <Grid>
                    <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,8,4,8">
                        <ItemsControl x:Name="SkinGrid" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      VirtualizingStackPanel.IsVirtualizing="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="156">
                                        <components:SkinItemControl Width="150" Height="150" Margin="2,2,4,0"
                                                                    Loaded="SkinItemControl_Loaded"
                                                                    Selected="SkinItemControl_Selected"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource GlobalFontSize}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,4,0,8"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:DynamicScrollViewer>
                    <!-- 加载提示 -->
                    <TextBlock x:Name="LoadingOverlay" Text="{DynamicResource SkinLoading}" Visibility="Collapsed"
                               Panel.ZIndex="10"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource GlobalFontSize}"/>
                </Grid>
            </ui:Card>

            <!-- 右侧卡片 - 皮肤预览 -->
            <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="0" VerticalAlignment="Stretch">
                <components:SkinPreviewControl x:Name="SkinPreview"/>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>