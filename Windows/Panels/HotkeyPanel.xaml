<UserControl x:Class="CraftSharp.Windows.Panels.HotkeyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource HotkeyPanelTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Text="{DynamicResource HotkeyPanelDesc}" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 打开背包 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource HotkeyInventoryLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyInventoryDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary" Width="100" Content="E"
                           x:Name="InventoryHotkeyBtn" Click="HotkeyButton_Click"/>
            </Grid>
        </ui:Card>

        <!-- 打开设置 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource HotkeySettingsLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource HotkeySettingsDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary" Width="100" Content="Ctrl+S"
                           x:Name="SettingsHotkeyBtn" Click="HotkeyButton_Click"/>
            </Grid>
        </ui:Card>

        <!-- 显示/隐藏快捷栏 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource HotkeyHotbarLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource HotkeyHotbarDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary" Width="100" Content="{DynamicResource HotkeyNotSet}"
                           x:Name="HotbarToggleHotkeyBtn" Click="HotkeyButton_Click"/>
            </Grid>
        </ui:Card>
    </StackPanel>
</UserControl>