<UserControl x:Class="CraftSharp.Windows.Panels.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="外观设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- 主题卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="主题" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="选择界面显示风格" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="ThemeComboBox"
                          SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="跟随系统"/>
                    <ComboBoxItem Content="暗色"/>
                    <ComboBoxItem Content="亮色"/>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- 字体卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="字体" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="选择界面显示字体" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="FontComboBox"
                          SelectedIndex="0" SelectionChanged="FontComboBox_SelectionChanged">
                    <ComboBoxItem Content="跟随系统"/>
                    <ComboBoxItem Content="微软雅黑"/>
                    <ComboBoxItem Content="宋体"/>
                    <ComboBoxItem Content="黑体"/>
                    <ComboBoxItem Content="楷体"/>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- 图标风格卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="图标风格" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="选择界面图标风格" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="IconStyleComboBox"
                          SelectedIndex="0" SelectionChanged="IconStyleComboBox_SelectionChanged">
                    <ComboBoxItem Content="跟随系统"/>
                    <ComboBoxItem Content="像素风格"/>
                    <ComboBoxItem Content="简约风格"/>
                    <ComboBoxItem Content="写实风格"/>
                </ComboBox>
            </Grid>
        </ui:Card>
    </StackPanel>
</UserControl>