<UserControl x:Class="CraftSharp.Windows.Panels.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource AppearancePanelTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 主题卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ThemeDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="ThemeComboBox"
                          SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource ThemeSystem}" Tag="system"/>
                    <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="dark"/>
                    <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="light"/>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- 字体卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource FontLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource FontDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="FontComboBox"
                          SelectedIndex="0" SelectionChanged="FontComboBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource FontDefault}"/>
                    <ComboBoxItem Content="{DynamicResource FontYaHei}"/>
                    <ComboBoxItem Content="{DynamicResource FontSongTi}"/>
                    <ComboBoxItem Content="{DynamicResource FontHeiTi}"/>
                    <ComboBoxItem Content="{DynamicResource FontKaiTi}"/>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- 图标风格卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource IconStyleLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource IconStyleDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="IconStyleComboBox"
                          SelectedIndex="0" SelectionChanged="IconStyleComboBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource FontDefault}"/>
                    <ComboBoxItem Content="{DynamicResource IconStylePixel}"/>
                    <ComboBoxItem Content="{DynamicResource IconStyleSimple}"/>
                    <ComboBoxItem Content="{DynamicResource IconStyleRealistic}"/>
                </ComboBox>
            </Grid>
        </ui:Card>
    </StackPanel>
</UserControl>