<UserControl x:Class="CraftSharp.Windows.Panels.HudPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="HUD 设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <TextBlock Text="自定义快捷栏上显示的 HUD 元素" Margin="0,0,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <StackPanel x:Name="HudAccordionContainer"/>
    </StackPanel>
</UserControl>