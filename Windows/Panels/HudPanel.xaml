<UserControl x:Class="CraftSharp.Windows.Panels.HudPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource HudPanelTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 副标题 -->
        <TextBlock Text="{DynamicResource HudStatusBarSettings}" FontSize="16" FontWeight="Medium" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel x:Name="HudAccordionContainer"/>
    </StackPanel>
</UserControl>