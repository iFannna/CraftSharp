<UserControl x:Class="CraftSharp.Windows.Panels.HudAccordionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,0,0,8">
        <!-- Header -->
        <ui:Card x:Name="HeaderCard" Padding="16" MouseLeftButtonDown="Header_Click" Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <ui:SymbolIcon x:Name="ArrowIcon" Grid.Column="1" Symbol="ChevronDown20"
                               FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </ui:Card>

        <!-- Content -->
        <ui:Card x:Name="ContentCard" Margin="0,8,0,0" Padding="16" Visibility="Collapsed">
            <StackPanel x:Name="ContentPanel"/>
        </ui:Card>
    </StackPanel>
</UserControl>