<Window x:Class="CraftSharp.Windows.StatusBar.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="状态栏"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        WindowStartupLocation="Manual">

    <!-- 根Grid：整个状态栏水平居中，垂直紧贴窗口底部 -->
    <Grid x:Name="RootGrid" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          HorizontalAlignment="Center" VerticalAlignment="Bottom">

        <!-- 主容器Grid：包含副手槽和核心容器 -->
        <!-- 使用五列布局：左副手槽 | 左间距 | 核心容器 | 右间距 | 右副手槽 -->
        <!-- 所有列使用固定宽度，避免Collapsed时列收缩导致位置偏移 -->
        <Grid x:Name="MainContainerGrid" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="LeftOffhandColumn"/> <!-- 左副手槽列（固定宽度） -->
                <ColumnDefinition Width="*" x:Name="LeftSpacingColumn"/> <!-- 左间距列（固定宽度） -->
                <ColumnDefinition Width="*" x:Name="CoreContainerColumn"/> <!-- 核心容器列（固定宽度） -->
                <ColumnDefinition Width="*" x:Name="RightSpacingColumn"/> <!-- 右间距列（固定宽度） -->
                <ColumnDefinition Width="*" x:Name="RightOffhandColumn"/> <!-- 右副手槽列（固定宽度） -->
            </Grid.ColumnDefinitions>

            <!-- ===== 左副手槽（Column=0） ===== -->
            <!-- 原图22×22，Margin=3px，格子16×16 -->
            <Grid x:Name="LeftOffhandGrid" Grid.Column="0"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center">
                <Image x:Name="LeftOffhandImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       UseLayoutRounding="True"
                       SnapsToDevicePixels="True"/>
                <!-- 左副手格子，Margin在代码中动态设置 -->
                <Border x:Name="SlotLeftOffhand" Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="IconLeftOffhand" Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Visibility="Collapsed"/>
                </Border>
            </Grid>

            <!-- ===== 左间距列（Column=1） ===== -->
            <Grid x:Name="LeftOffhandSpacingGrid" Grid.Column="1"/>

            <!-- ===== 核心容器（Column=2） ===== -->
            <!-- 固定宽度182*scaleFactor -->
            <!-- StackPanel从上往下排列，靠底部对齐 -->
            <!-- XAML顺序：状态组(最先) → 经验条 → 快捷栏(最后) -->
            <!-- 显示顺序：状态组(上) → 经验条 → 快捷栏(下) -->
            <Grid x:Name="CoreContainerGrid" Grid.Column="2"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center">

                <StackPanel x:Name="VerticalStackPanel"
                            Orientation="Vertical"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center">

                    <!-- ===== 状态组行（最先写，显示在最上方） ===== -->
                    <!-- Margin.Top会在状态组上方创建间距（无上一级，所以Margin.Top=0） -->
                    <!-- Margin.Bottom会在状态组和经验条之间创建间距 -->
                    <Grid x:Name="StatusRowGrid" HorizontalAlignment="Center" Height="Auto">
                        <!-- 左列：护甲值(上) → 伤害吸收 → 生命值(下) -->
                        <!-- StackPanel从上往下排列，靠底部对齐 -->
                        <!-- XAML顺序：护甲值(最先) → 伤害吸收 → 生命值(最后) -->
                        <!-- 显示顺序：护甲值(上) → 伤害吸收 → 生命值(下) -->
                        <StackPanel x:Name="LeftStatusStackPanel"
                                    Orientation="Vertical"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left">
                            <!-- 护甲值（最先写，显示在最上方） -->
                            <!-- Margin.Bottom在护甲值和伤害吸收之间创建间距 -->
                            <Grid x:Name="ArmorGrid" HorizontalAlignment="Left" Height="Auto">
                                <!-- 护甲值图片动态添加 -->
                            </Grid>
                            <!-- 伤害吸收（第二个写，显示在护甲值下方） -->
                            <!-- Margin.Bottom在伤害吸收和生命值之间创建间距 -->
                            <Grid x:Name="AbsorbingGrid" HorizontalAlignment="Left" Height="Auto">
                                <Canvas x:Name="AbsorbingCanvas"/>
                            </Grid>
                            <!-- 生命值（最后写，显示在最下方） -->
                            <!-- 无Margin.Bottom（下方无元素） -->
                            <Grid x:Name="HeartGrid" HorizontalAlignment="Left" Height="Auto">
                                <Canvas x:Name="HeartCanvas"/>
                            </Grid>
                        </StackPanel>

                        <!-- 右列：空气值(上) → 饥饿值(下) -->
                        <!-- StackPanel从上往下排列，靠底部对齐 -->
                        <!-- XAML顺序：空气值(最先) → 饥饿值(最后) -->
                        <!-- 显示顺序：空气值(上) → 饥饿值(下) -->
                        <StackPanel x:Name="RightStatusStackPanel"
                                    Orientation="Vertical"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right">
                            <!-- 空气值（最先写，显示在最上方） -->
                            <!-- Margin.Bottom在空气值和饥饿值之间创建间距 -->
                            <Grid x:Name="AirGrid" HorizontalAlignment="Right" Height="Auto">
                                <Canvas x:Name="AirCanvas"/>
                            </Grid>
                            <!-- 饥饿值（最后写，显示在最下方） -->
                            <!-- 无Margin.Bottom（下方无元素） -->
                            <Grid x:Name="FoodGrid" HorizontalAlignment="Right" Height="Auto">
                                <Canvas x:Name="FoodCanvas"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 经验条（第二个写，显示在状态组下方） ===== -->
                    <!-- Margin.Bottom会在经验条和快捷栏之间创建间距 -->
                    <!-- Margin.Top会在状态组和经验条之间创建间距（使用0） -->
                    <Grid x:Name="ExperienceBarGrid" HorizontalAlignment="Center" Height="Auto">
                        <Image x:Name="ExperienceBarBackground"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               UseLayoutRounding="True"
                               SnapsToDevicePixels="True"/>
                        <Image x:Name="ExperienceBarProgress"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               UseLayoutRounding="True"
                               SnapsToDevicePixels="True"
                               HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- ===== 快捷栏（最后写，显示在最下方） ===== -->
                    <!-- 无Margin.Bottom（下方无元素） -->
                    <!-- Margin.Top会在经验条和快捷栏之间创建间距（使用0） -->
                    <!-- 快捷栏原图182×22，格子布局：外边距3px，格子16×16，间距4px -->
                    <Grid x:Name="HotbarGrid" HorizontalAlignment="Center" Height="Auto">
                        <Image x:Name="HotbarImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               UseLayoutRounding="True"
                               SnapsToDevicePixels="True"/>
                        <!-- 格子容器Grid：Margin在代码中动态设置 -->
                        <Grid x:Name="HotbarSlotsGrid"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True">
                            <!-- 主快捷栏格子 (9个) - 动态添加 -->
                        </Grid>
                        <!-- 选中框叠加层：Canvas 允许内容超出边界不被裁剪 -->
                        <Canvas x:Name="SelectionOverlayCanvas"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True"
                              IsHitTestVisible="False">
                            <!-- selection 图片动态添加 -->
                        </Canvas>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===== 右间距列（Column=3） ===== -->
            <Grid x:Name="RightOffhandSpacingGrid" Grid.Column="3"/>

            <!-- ===== 右副手槽（Column=4） ===== -->
            <!-- 原图22×22，Margin=3px，格子16×16 -->
            <Grid x:Name="RightOffhandGrid" Grid.Column="4"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center">
                <Image x:Name="RightOffhandImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       UseLayoutRounding="True"
                       SnapsToDevicePixels="True"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="RightOffhandScaleTransform" ScaleX="-1"/>
                    </Image.RenderTransform>
                </Image>
                <!-- 右副手格子，Margin在代码中动态设置 -->
                <Border x:Name="SlotRightOffhand" Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="IconRightOffhand" Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Visibility="Collapsed"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>