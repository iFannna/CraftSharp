<ui:FluentWindow x:Class="CraftSharp.Windows.HudIconPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource HudIconPickerTitle}"
                 Height="300" Width="400" MinHeight="250" MinWidth="300"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource HudIconPickerTitle}" ShowMinimize="False" ShowMaximize="True" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 图标网格 -->
        <Grid Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}">
            <ScrollViewer Padding="16">
                <ItemsControl x:Name="IconGrid" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="64" Height="64" Margin="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="IconItem_Click"
                                    ToolTip="{Binding DisplayName}"
                                    ToolTipService.InitialShowDelay="0"
                                    ToolTipService.ShowDuration="5000">
                                <Image Source="{Binding BitmapImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 加载指示器 -->
            <TextBlock x:Name="LoadingOverlay" Text="{DynamicResource IconPickerLoading}"
                       Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
        </Grid>
    </Grid>
</ui:FluentWindow>