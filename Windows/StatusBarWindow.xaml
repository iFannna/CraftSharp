<Window x:Class="CraftSharp.Windows.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="状态栏"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

    <Grid x:Name="RootGrid">
        <Canvas x:Name="MainCanvas">
            <!-- 心形生命值容器 -->
            <Canvas x:Name="HeartCanvas">
                <!-- 10个心形图片将在代码中动态创建 -->
            </Canvas>

            <!-- 饥饿值容器 -->
            <Canvas x:Name="FoodCanvas">
                <!-- 10个饥饿值图片将在代码中动态创建 -->
            </Canvas>

            <!-- 空气值容器 -->
            <Canvas x:Name="AirCanvas">
                <!-- 10个空气值图片将在代码中动态创建 -->
            </Canvas>

            <!-- 伤害吸收值容器 -->
            <Canvas x:Name="AbsorbingCanvas">
                <!-- 伤害吸收值图片将在代码中动态创建（每行10个，最多6行） -->
            </Canvas>

            <!-- 经验条 -->
            <Grid x:Name="ExperienceBarGrid">
                <!-- 背景 -->
                <Image x:Name="ExperienceBarBackground"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       UseLayoutRounding="True"
                       SnapsToDevicePixels="True"/>
                <!-- 进度（宽度根据电量动态设置） -->
                <Image x:Name="ExperienceBarProgress"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       UseLayoutRounding="True"
                       SnapsToDevicePixels="True"
                       HorizontalAlignment="Left"/>
            </Grid>

            <!-- 副手槽背景 -->
            <Image Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   UseLayoutRounding="True"
                   SnapsToDevicePixels="True"
                   x:Name="OffhandImage"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="OffhandScaleTransform" ScaleX="1"/>
                </Image.RenderTransform>
            </Image>

            <!-- 快捷栏背景 -->
            <Image Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   UseLayoutRounding="True"
                   SnapsToDevicePixels="True"
                   x:Name="HotbarImage"/>

            <!-- 格子容器 - 位置在代码中动态设置 -->
            <Canvas x:Name="SlotCanvas">
                <!-- 副手格子 -->
                <Border x:Name="SlotOffhand" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="IconOffhand" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>

                <!-- 主快捷栏格子 (9个) -->
                <Border x:Name="Slot0" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon0" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot1" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon1" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot2" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon2" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot3" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon3" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot4" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon4" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot5" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon5" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot6" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon6" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot7" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon7" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Slot8" Background="Transparent"
                        MouseLeftButtonDown="Slot_Click"
                        AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                    <Image x:Name="Icon8" Stretch="Uniform" Visibility="Collapsed"/>
                </Border>
            </Canvas>
        </Canvas>
    </Grid>
</Window>