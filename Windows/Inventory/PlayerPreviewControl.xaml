<UserControl x:Class="CraftSharp.Windows.Inventory.PlayerPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="clr-namespace:HelixToolkit.Wpf.SharpDX;assembly=HelixToolkit.Wpf.SharpDX"
             Background="Transparent">

    <Grid x:Name="RootGrid" Background="Transparent">
        <hx:Viewport3DX x:Name="Viewport"
                        Background="Transparent"
                        ShowCoordinateSystem="False"
                        ShowViewCube="False"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        IsRotationEnabled="False"
                        ModelUpDirection="0,1,0"
                        OITRenderMode="None">
            <hx:AmbientLight3D Color="White"/>
            <hx:GroupModel3D x:Name="BodyModelGroup"/>
        </hx:Viewport3DX>
    </Grid>
</UserControl>