<Window x:Class="CraftSharp.Windows.Inventory.InventoryTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CraftSharp.Controls"
        Title="Tooltip"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False">

    <Grid x:Name="TooltipGrid">
        <!-- 背景层（九宫格贴图） -->
        <controls:NineSliceImage x:Name="BackgroundImage"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>

        <!-- 边框层（九宫格贴图） -->
        <controls:NineSliceImage x:Name="FrameImage"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>

        <!-- 内容容器 -->
        <StackPanel x:Name="ContentPanel"
                    Orientation="Vertical">
            <!-- 文本行将在代码中动态创建 -->
        </StackPanel>
    </Grid>
</Window>