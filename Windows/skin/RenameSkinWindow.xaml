<ui:FluentWindow x:Class="CraftSharp.Windows.Skin.RenameSkinWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="重命名皮肤"
                 Height="Auto" MinHeight="0" Width="360" MinWidth="320"
                 WindowStartupLocation="CenterOwner"
                 SizeToContent="Height"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="重命名皮肤" ShowMinimize="False" ShowMaximize="False" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock Text="新名称" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <ui:TextBox x:Name="NameTextBox" TextChanged="NameTextBox_TextChanged"/>
            <TextBlock x:Name="ValidationErrorText" Text="" FontSize="12" Foreground="#E53935" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="1" Content="取消" Appearance="Secondary" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <ui:Button Grid.Column="2" x:Name="ConfirmButton" Content="确认" Appearance="Primary" Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
