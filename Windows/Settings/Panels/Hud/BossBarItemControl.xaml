<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Hud.BossBarItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="Auto" Height="Auto"
             RenderTransformOrigin="0.5,0.5">

    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            <TranslateTransform x:Name="TranslateTransform" Y="0"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- 拖动状态动画：缩小+半透明 -->
        <Storyboard x:Key="DragStateStoryboard">
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.95" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.95" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0.6" Duration="0:0:0.1"/>
        </Storyboard>

        <!-- 归位动画：恢复原始状态 -->
        <Storyboard x:Key="RestoreStoryboard" FillBehavior="Stop">
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="TranslateTransform"
                             Storyboard.TargetProperty="Y"
                             To="0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 吸附动画：快速归位 -->
        <Storyboard x:Key="SnapStoryboard" FillBehavior="Stop">
            <DoubleAnimation Storyboard.TargetName="TranslateTransform"
                             Storyboard.TargetProperty="Y"
                             To="0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.12"/>
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,4,0,4"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            x:Name="RootBorder"
            IsHitTestVisible="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：排序图标（拖动手柄） -->
            <Border Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0"
                    Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="OnDragHandleMouseDown"
                    x:Name="DragHandleBorder">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill" Width="16" Height="2" Margin="0,2"
                          Data="M0,0 L16,0 L16,2 L0,2 Z"/>
                    <Path Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill" Width="16" Height="2" Margin="0,2"
                          Data="M0,0 L16,0 L16,2 L0,2 Z"/>
                    <Path Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill" Width="16" Height="2" Margin="0,2"
                          Data="M0,0 L16,0 L16,2 L0,2 Z"/>
                </StackPanel>
            </Border>

            <!-- 中间：BOSS图标预览 + 名称 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- BOSS血条图标预览（364x10） -->
                <Border Width="364" Height="10" Margin="0,0,12,0"
                        x:Name="IconPreviewBorder">
                    <Grid>
                        <!-- 底层：元素图标 -->
                        <Image x:Name="IconPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <!-- 上层：等级图标 -->
                        <Image x:Name="NotchPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>
                </Border>
                <!-- BOSS名称 -->
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 右侧：编辑按钮 -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                <Hyperlink x:Name="EditLink"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextDecorations="None"
                           Cursor="Hand"
                           Click="EditLink_Click">
                    <Run Text="{DynamicResource BossBarItemEdit}"/>
                </Hyperlink>
            </TextBlock>

            <!-- 右侧：启用按钮 -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="4,0">
                <Hyperlink x:Name="EnableLink"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextDecorations="None"
                           Cursor="Hand"
                           Click="EnableLink_Click">
                    <Run x:Name="EnableRun" Text="{DynamicResource BossBarItemEnable}"/>
                </Hyperlink>
            </TextBlock>

            <!-- 右侧：删除按钮 -->
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="4,0">
                <Hyperlink x:Name="DeleteLink"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextDecorations="None"
                           Cursor="Hand"
                           Click="DeleteLink_Click">
                    <Run Text="{DynamicResource BossBarItemDelete}"/>
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>