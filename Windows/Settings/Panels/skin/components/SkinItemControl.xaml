<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Skin.Components.SkinItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="clr-namespace:HelixToolkit.Wpf.SharpDX;assembly=HelixToolkit.Wpf.SharpDX"
             Width="150" Height="150">
    <Border x:Name="ItemBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8"
            BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
            MouseLeftButtonDown="ItemBorder_MouseLeftButtonDown">
        <hx:Viewport3DX x:Name="Viewport"
                        Background="Transparent"
                        ShowCoordinateSystem="False"
                        ShowViewCube="False"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        IsRotationEnabled="False"
                        CameraRotationMode="Turntable"
                        OITRenderMode="None">
            <hx:AmbientLight3D Color="White"/>
            <hx:GroupModel3D x:Name="ModelGroup"/>
        </hx:Viewport3DX>
    </Border>
</UserControl>