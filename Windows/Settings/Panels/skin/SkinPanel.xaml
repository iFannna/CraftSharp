<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Skin.SkinPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:CraftSharp.Windows.Settings.Panels.Skin.Components"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部卡片 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧选项按钮 -->
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="BorderSteve" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OptionBorder_Click">
                        <TextBlock x:Name="TextSteve" Text="Steve" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                    </Border>
                    <Border x:Name="BorderAlex" Background="Transparent" CornerRadius="6" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OptionBorder_Click">
                        <TextBlock x:Name="TextAlex" Text="Alex" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border x:Name="BorderUpload" Background="Transparent" CornerRadius="6" Padding="12,8" Cursor="Hand" MouseLeftButtonDown="OptionBorder_Click">
                        <TextBlock x:Name="TextUpload" Text="{DynamicResource SkinTabUpload}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 右侧搜索框 -->
                <ui:TextBox Grid.Column="1" Width="180" HorizontalAlignment="Right"
                            PlaceholderText="{DynamicResource SkinSearchPlaceholder}"
                            ClearButtonEnabled="True"/>
            </Grid>
        </ui:Card>

        <!-- 左右分栏区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.65*"/>
                <ColumnDefinition Width="0.35*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧卡片 - 皮肤列表 -->
            <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="0" VerticalAlignment="Stretch">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,8,4,8">
                        <ItemsControl x:Name="SkinGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="154"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:SkinItemControl Width="150" Height="150" Margin="2"
                                                                Loaded="SkinItemControl_Loaded"
                                                                Selected="SkinItemControl_Selected"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 加载提示 -->
                    <TextBlock x:Name="LoadingOverlay" Text="加载中..." Visibility="Collapsed"
                               Panel.ZIndex="10"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                </Grid>
            </ui:Card>

            <!-- 右侧卡片 -->
            <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="16" VerticalAlignment="Stretch">
                <!-- 暂不实现具体内容 -->
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>