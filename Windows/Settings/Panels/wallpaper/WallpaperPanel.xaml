<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Wallpaper.WallpaperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             VerticalAlignment="Stretch">

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{DynamicResource WallpaperPanelTitle}" FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,20" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 筛选栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <ui:Button x:Name="FilterAll" Content="{DynamicResource WallpaperAll}" Tag="all"
                           Appearance="Primary" Margin="0,0,4,0" Padding="16,6" FontSize="13"
                           Click="FilterButton_Click"/>
                <ui:Button x:Name="FilterStatic" Content="{DynamicResource WallpaperStatic}" Tag="static"
                           Appearance="Secondary" Margin="0,0,4,0" Padding="16,6" FontSize="13"
                           Click="FilterButton_Click"/>
                <ui:Button x:Name="FilterDynamic" Content="{DynamicResource WallpaperDynamic}" Tag="dynamic"
                           Appearance="Secondary" Padding="16,6" FontSize="13"
                           Click="FilterButton_Click"/>
            </StackPanel>

            <ComboBox x:Name="SortComboBox" MinWidth="100" Padding="16,6" FontSize="13"
                      VerticalAlignment="Center" SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource WallpaperSortLatest}" Tag="latest"/>
                <ComboBoxItem Content="{DynamicResource WallpaperSortHot}" Tag="hot"/>
                <ComboBoxItem Content="{DynamicResource WallpaperSortDownloads}" Tag="downloads"/>
            </ComboBox>
        </StackPanel>

        <!-- 内容区 -->
        <Grid Grid.Row="2">
            <!-- 壁纸网格 -->
            <ListBox x:Name="WallpaperListBox"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="WallpaperGrid" Columns="4"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border CornerRadius="8" ClipToBounds="True" Background="#1a1a1a">
                                <Grid>
                                    <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True"
                                                     Width="32" Height="32" Opacity="0.6"/>
                                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="24" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource WallpaperLoadFailed}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Image x:Name="ThumbnailImage" Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           Visibility="Collapsed"/>
                                    <Border x:Name="DynamicBadge" Visibility="Collapsed"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="6" Padding="4,2" CornerRadius="4"
                                            Background="#9B59B6" Opacity="0.9">
                                        <TextBlock Text="{DynamicResource WallpaperDynamicBadge}"
                                                   FontSize="10" Foreground="White"/>
                                    </Border>
                                    <Border x:Name="HoverOverlay"
                                            Background="#80000000"
                                            Visibility="Visible" Opacity="0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:Button Content="{DynamicResource WallpaperViewImage}"
                                                       Appearance="Secondary" FontSize="11" Padding="10,5"
                                                       Margin="0,0,8,0"
                                                       Click="ViewImage_Click"/>
                                            <ui:Button Content="{DynamicResource WallpaperQuickSet}"
                                                       Appearance="Primary" FontSize="11" Padding="10,5"
                                                       Click="QuickSetWallpaper_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 底部悬浮信息 -->
                                    <Border VerticalAlignment="Bottom" Background="#80000000"
                                            Padding="8,6">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Resolution}" FontSize="11"
                                                       Foreground="#CCFFFFFF"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>

                        <DataTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.03" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.03" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 错误状态 -->
            <StackPanel x:Name="ErrorStack" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource WallpaperErrorTitle}" FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="ErrorMessage" Text="{DynamicResource WallpaperErrorDesc}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                           Margin="0,0,0,16"/>
                <ui:Button Content="{DynamicResource WallpaperRetry}" Appearance="Primary"
                           HorizontalAlignment="Center" Padding="24,8" FontSize="13"
                           Click="RetryButton_Click"/>
            </StackPanel>

            <!-- 加载中 -->
            <StackPanel x:Name="LoadingStack" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource WallpaperLoading}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 分页栏 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button x:Name="PrevPageBtn" Content="{DynamicResource WallpaperPrev}"
                           Appearance="Secondary" Padding="16,6" FontSize="13" Margin="0,0,8,0"
                           Click="PrevPage_Click"/>
                <TextBlock x:Name="PageInfo" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:Button x:Name="NextPageBtn" Content="{DynamicResource WallpaperNext}"
                           Appearance="Secondary" Padding="16,6" FontSize="13"
                           Click="NextPage_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
