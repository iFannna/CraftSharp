<ui:FluentWindow x:Class="CraftSharp.Windows.Settings.Panels.Wallpaper.WallpaperPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource WallpaperPreviewTitle}"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False"
                 Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource WallpaperPreviewTitle}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     FontSize="14" FontWeight="Medium"
                     Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 图片预览区 -->
        <Grid Grid.Row="1" x:Name="RootGrid"
              MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
              MouseWheel="RootGrid_MouseWheel">

            <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- 上一张 -->
            <ui:Button x:Name="PrevBtn" Panel.ZIndex="1"
                       Width="32" Height="32" Margin="12,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Appearance="Secondary" Padding="0" CornerRadius="16"
                       Click="PrevBtn_Click">
                <Path Data="M 6 0 L 0 6 L 6 12"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeThickness="2" Width="10" Height="12" Stretch="Uniform"/>
            </ui:Button>

            <!-- 下一张 -->
            <ui:Button x:Name="NextBtn" Panel.ZIndex="1"
                       Width="32" Height="32" Margin="0,0,12,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Appearance="Secondary" Padding="0" CornerRadius="16"
                       Click="NextBtn_Click">
                <Path Data="M 0 0 L 6 6 L 0 12"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeThickness="2" Width="10" Height="12" Stretch="Uniform"/>
            </ui:Button>
        </Grid>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,8,0,12">
                <!-- 缩小 -->
                <ui:Button x:Name="ZoomOutBtn" Margin="0,0,4,0" Width="32" Height="32"
                           Appearance="Secondary" Padding="0"
                           Click="ZoomOutBtn_Click">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"/>
                </ui:Button>

                <!-- 放大 -->
                <ui:Button x:Name="ZoomInBtn" Margin="0,0,4,0" Width="32" Height="32"
                           Appearance="Secondary" Padding="0"
                           Click="ZoomInBtn_Click">
                    <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets"/>
                </ui:Button>

                <!-- 适应 -->
                <ui:Button x:Name="FitBtn" Margin="0,0,4,0" Width="32" Height="32"
                           Appearance="Secondary" Padding="0"
                           Click="FitBtn_Click" ToolTip="{DynamicResource WallpaperPreviewFit}">
                    <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets"/>
                </ui:Button>

                <!-- 分隔线 -->
                <Border Width="1" Margin="8,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                <!-- 设为壁纸 -->
                <ui:Button x:Name="SetWallpaperBtn" Margin="0,0,6,0"
                           Appearance="Primary" Padding="14,6" FontSize="12"
                           Click="SetWallpaperBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource WallpaperSetWallpaper}"/>
                    </StackPanel>
                </ui:Button>

                <!-- 下载 -->
                <ui:Button x:Name="DownloadBtn"
                           Appearance="Secondary" Padding="14,6" FontSize="12"
                           Click="DownloadBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource WallpaperDownload}"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
