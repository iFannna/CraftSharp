<Window x:Class="CraftSharp.Windows.Settings.Panels.Wallpaper.WallpaperPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#CC000000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True">

    <Grid x:Name="RootGrid" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseWheel="RootGrid_MouseWheel">
        <!-- 壁纸图片 -->
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 关闭按钮 -->
        <Button x:Name="CloseBtn" Width="36" Height="36"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                Style="{DynamicResource WpfUiIconButtonStyle}" FontSize="18"
                Click="CloseBtn_Click" ToolTip="{DynamicResource WallpaperPreviewClose}">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
        </Button>

        <!-- 底部操作栏 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Padding="16,12" Margin="0,0,0,16" CornerRadius="12"
                Background="#99000000">
            <StackPanel Orientation="Horizontal">
                <!-- 上一张 -->
                <RepeatButton x:Name="PrevBtn" Margin="0,0,6,0" Width="36" Height="36"
                              Style="{DynamicResource WpfUiIconButtonStyle}" FontSize="14"
                              Click="PrevBtn_Click" Interval="300">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"/>
                </RepeatButton>

                <!-- 缩小 -->
                <Button x:Name="ZoomOutBtn" Margin="0,0,6,0" Width="36" Height="36"
                        Style="{DynamicResource WpfUiIconButtonStyle}" FontSize="14"
                        Click="ZoomOutBtn_Click">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"/>
                </Button>

                <!-- 放大 -->
                <Button x:Name="ZoomInBtn" Margin="0,0,6,0" Width="36" Height="36"
                        Style="{DynamicResource WpfUiIconButtonStyle}" FontSize="14"
                        Click="ZoomInBtn_Click">
                    <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets"/>
                </Button>

                <!-- 适应 -->
                <Button x:Name="FitBtn" Margin="0,0,12,0" Width="36" Height="36"
                        Style="{DynamicResource WpfUiIconButtonStyle}" FontSize="14"
                        Click="FitBtn_Click" ToolTip="{DynamicResource WallpaperPreviewFit}">
                    <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets"/>
                </Button>

                <!-- 设为壁纸 -->
                <ui:Button x:Name="SetWallpaperBtn" Margin="0,0,6,0"
                           Appearance="Primary" Padding="16,8" FontSize="13"
                           Click="SetWallpaperBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource WallpaperSetWallpaper}"/>
                    </StackPanel>
                </ui:Button>

                <!-- 下载 -->
                <ui:Button x:Name="DownloadBtn" Margin="0,0,12,0"
                           Appearance="Secondary" Padding="16,8" FontSize="13"
                           Click="DownloadBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource WallpaperDownload}"/>
                    </StackPanel>
                </ui:Button>

                <!-- 下一张 -->
                <RepeatButton x:Name="NextBtn" Width="36" Height="36"
                              Style="{DynamicResource WpfUiIconButtonStyle}" FontSize="14"
                              Click="NextBtn_Click" Interval="300">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"/>
                </RepeatButton>
            </StackPanel>
        </Border>
    </Grid>
</Window>
