<UserControl x:Class="CraftSharp.Windows.Settings.Panels.Appearance.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- 标题 -->
        <TextBlock Text="{DynamicResource AppearancePanelTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 应用图标卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource AppIconLabel}" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource AppIconDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Cursor="Hand" MouseLeftButtonDown="AppIconPreview_Click"
                        x:Name="AppIconPreviewBorder"
                        ToolTip="{DynamicResource AppIconTooltip}">
                    <Image x:Name="AppIconPreview" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </Grid>
        </ui:Card>

        <!-- 主题卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ThemeDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="ThemeComboBox"
                          SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource ThemeSystem}" Tag="system"/>
                    <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="dark"/>
                    <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="light"/>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- 字体卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource FontLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource FontDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="FontComboBox"
                          SelectionChanged="FontComboBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource FontYaHei}" Tag="yahei">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Microsoft YaHei" Style="{x:Null}"/>
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{DynamicResource FontPixel}" Tag="pixel">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="pack://application:,,,/Fonts/zpix.ttf#Zpix" Style="{x:Null}"/>
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{DynamicResource FontUnifont}" Tag="unifont">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="pack://application:,,,/Fonts/unifont-16.0.04.ttf#Unifont" Style="{x:Null}"/>
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{DynamicResource FontSongTi}" Tag="songti">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="SimSun" Style="{x:Null}"/>
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{DynamicResource FontKaiTi}" Tag="kaiti">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="KaiTi" Style="{x:Null}"/>
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{DynamicResource FontHeiTi}" Tag="heiti">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="SimHei" Style="{x:Null}"/>
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- 字体大小卡片 -->
        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource FontSizeLabel}" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource FontSizeDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="160" x:Name="FontSizeComboBox"
                          SelectedIndex="2" SelectionChanged="FontSizeComboBox_SelectionChanged">
                    <ComboBoxItem Content="10" Tag="10"/>
                    <ComboBoxItem Content="12" Tag="12"/>
                    <ComboBoxItem Content="14" Tag="14"/>
                    <ComboBoxItem Content="16" Tag="16"/>
                    <ComboBoxItem Content="18" Tag="18"/>
                    <ComboBoxItem Content="20" Tag="20"/>
                </ComboBox>
            </Grid>
        </ui:Card>
    </StackPanel>
</UserControl>