<ui:FluentWindow x:Class="CraftSharp.Windows.BossBar.BossBarEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource BossBarEditTitle}"
                 Height="Auto" Width="360" MinWidth="300"
                 WindowStartupLocation="CenterOwner"
                 SizeToContent="Height"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource BossBarEditTitle}" ShowMinimize="False" ShowMaximize="False" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 内容区域 -->
        <StackPanel Grid.Row="1" Margin="16">
            <!-- 元素图标预览 -->
            <TextBlock Text="{DynamicResource HudOptionElementIcon}" FontWeight="Medium" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Border x:Name="IconPreviewBorder" Height="32" HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="8"
                    Cursor="Hand" MouseLeftButtonDown="IconPreview_Click"
                    ToolTip="{DynamicResource HudOptionElementIconDesc}">
                <Image x:Name="IconPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- 等级预览（元素图标+等级图标叠加） -->
            <TextBlock Text="{DynamicResource BossBarNotchLabel}" FontWeight="Medium" Margin="0,16,0,8"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Border x:Name="NotchPreviewBorder" Height="32" HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="8"
                    Cursor="Hand" MouseLeftButtonDown="NotchPreview_Click"
                    ToolTip="{DynamicResource BossBarNotchDesc}">
                <Grid>
                    <!-- 底层：元素图标 -->
                    <Image x:Name="NotchIconPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <!-- 上层：等级图标 -->
                    <Image x:Name="NotchNotchPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Border>

            <!-- 名称输入 -->
            <TextBlock Text="{DynamicResource BossBarNameLabel}" FontWeight="Medium" Margin="0,16,0,8"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <ui:TextBox x:Name="NameTextBox" PlaceholderText="{DynamicResource BossBarNamePlaceholder}"
                        TextWrapping="NoWrap"/>

            <!-- 数据映射 -->
            <ui:ToggleSwitch x:Name="DataMappingToggle" Margin="0,16,0,8"
                             Content="{DynamicResource HudOptionDataMapping}"/>
            <ComboBox x:Name="DataMappingComboBox" Margin="0,0,0,8" Visibility="Collapsed">
                <ComboBoxItem Content="{DynamicResource DataMappingBattery}" Tag="电池电量"/>
                <ComboBoxItem Content="{DynamicResource DataMappingMemory}" Tag="内存占用率"/>
                <ComboBoxItem Content="{DynamicResource DataMappingCpu}" Tag="CPU利用率"/>
                <ComboBoxItem Content="{DynamicResource DataMappingGpu}" Tag="GPU利用率"/>
            </ComboBox>

            <!-- 自定义数值 -->
            <ui:ToggleSwitch x:Name="CustomValueToggle" Margin="0,16,0,8"
                             Content="{DynamicResource HudOptionCustomValue}"/>
            <Grid x:Name="CustomValueGrid" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource CustomCurrentValue}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="CurrentValueTextBox" Grid.Column="1" Text="100"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="/100" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- 按钮区域 -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="1" x:Name="CancelButton"
                       Content="{DynamicResource TopMostConfirmCancel}"
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       Click="CancelButton_Click"/>
            <ui:Button Grid.Column="2" x:Name="SaveButton"
                       Content="{DynamicResource BossBarEditSave}"
                       Appearance="Primary"
                       Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>