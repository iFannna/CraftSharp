<ui:FluentWindow x:Class="CraftSharp.Windows.SkinPreview.SkinPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:hx="clr-namespace:HelixToolkit.Wpf.SharpDX;assembly=HelixToolkit.Wpf.SharpDX"
                 Title="皮肤预览"
                 Height="450" Width="450"
                 MinHeight="300" MinWidth="300"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ResizeMode="CanResize"
                 ShowInTaskbar="True"
                 Topmost="False"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid PreviewMouseDown="Grid_PreviewMouseDown" PreviewMouseMove="Grid_PreviewMouseMove" PreviewMouseUp="Grid_PreviewMouseUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="皮肤预览" ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- HelixToolkit Viewport3DX -->
        <hx:Viewport3DX Grid.Row="1" x:Name="Viewport"
                        Background="Transparent"
                        ShowCoordinateSystem="True"
                        ShowViewCube="True"
                        ViewCubeSize="50"
                        ModelUpDirection="0,1,0"
                        CameraRotationMode="Turntable"
                        IsPanEnabled="False"
                        IsZoomEnabled="True"
                        ZoomDistanceLimitNear="10"
                        ZoomDistanceLimitFar="200">
            <!-- 单一环境光：均匀照明，不受方向影响 -->
            <hx:AmbientLight3D Color="White"/>
            <hx:GroupModel3D x:Name="PlayerModelGroup"/>
        </hx:Viewport3DX>

        <!-- 视角提示栏 -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="拖拽旋转 | 点击ViewCube切换视角 | 滚轮缩放"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>