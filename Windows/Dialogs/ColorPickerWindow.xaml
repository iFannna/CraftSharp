<ui:FluentWindow x:Class="CraftSharp.Windows.Dialogs.ColorPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource ColorPickerTitle}"
                 Height="Auto" MinHeight="0" Width="320" MinWidth="280"
                 WindowStartupLocation="CenterOwner"
                 SizeToContent="Height"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource ColorPickerTitle}" ShowMinimize="False" ShowMaximize="False" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 调色板区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 色谱区域（色相 + 饱和度） -->
            <Border Grid.Column="0" x:Name="SpectrumBorder" CornerRadius="8" Height="200" ClipToBounds="True"
                    Background="White" MouseLeftButtonDown="Spectrum_MouseDown" MouseMove="Spectrum_MouseMove" MouseLeftButtonUp="Spectrum_MouseUp">
                <Grid IsHitTestVisible="False">
                    <!-- 色相渐变（横向从红到红） -->
                    <Rectangle x:Name="HueGradient">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.167"/>
                                <GradientStop Color="#00FF00" Offset="0.333"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.667"/>
                                <GradientStop Color="#FF00FF" Offset="0.833"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 饱和度渐变（纵向从透明到白色） -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 选择指示器 -->
                    <Border x:Name="SpectrumSelector" Width="12" Height="12" CornerRadius="6" BorderBrush="White" BorderThickness="2"
                            Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- 明度条（垂直） -->
            <Border Grid.Column="1" x:Name="BrightnessBorder" Width="24" Height="200" CornerRadius="8" Margin="8,0,0,0" ClipToBounds="True"
                    Background="Transparent" MouseLeftButtonDown="Brightness_MouseDown" MouseMove="Brightness_MouseMove" MouseLeftButtonUp="Brightness_MouseUp">
                <Grid IsHitTestVisible="False">
                    <Rectangle x:Name="BrightnessGradient">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 明度选择指示器 -->
                    <Border x:Name="BrightnessSelector" Width="24" Height="4" CornerRadius="2" BorderBrush="White" BorderThickness="1"
                            Background="Transparent" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- 不透明度条（垂直） -->
            <Border Grid.Column="2" x:Name="OpacityBorder" Width="24" Height="200" CornerRadius="8" Margin="8,0,0,0" ClipToBounds="True"
                    Background="Transparent" MouseLeftButtonDown="Opacity_MouseDown" MouseMove="Opacity_MouseMove" MouseLeftButtonUp="Opacity_MouseUp">
                <Grid IsHitTestVisible="False">
                    <!-- 棋盘格背景 -->
                    <Rectangle x:Name="OpacityCheckerboard">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="White">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,8,8"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#CCCCCC">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,4,4"/>
                                                    <RectangleGeometry Rect="4,4,4,4"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 不透明度渐变 -->
                    <Rectangle x:Name="OpacityGradient">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 不透明度选择指示器 -->
                    <Border x:Name="OpacitySelector" Width="24" Height="4" CornerRadius="2" BorderBrush="Gray" BorderThickness="1"
                            Background="Transparent" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 颜色预览区域 -->
        <Border Grid.Row="2" Margin="16,8,16,8" CornerRadius="8" Height="40">
            <!-- 棋盘格背景用于显示透明效果 -->
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="White">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,10,10"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#CCCCCC">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,5,5"/>
                                        <RectangleGeometry Rect="5,5,5,5"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <!-- 预览颜色覆盖层 -->
            <Border x:Name="PreviewColorOverlay" CornerRadius="8" Background="#FFFFFFFF"/>
        </Border>

        <!-- 颜色值输入区域 -->
        <StackPanel Grid.Row="3" Margin="16,0,16,8">
            <!-- HEX 行 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="HEX" FontWeight="Medium" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="HexInput" Text="#FFFFFF" FontWeight="Medium"
                         VerticalAlignment="Center" Padding="8,4" TextChanged="HexInput_TextChanged"/>
                <TextBox Grid.Column="2" x:Name="AlphaPercentInput" Text="100%" FontWeight="Medium" Width="60" Margin="8,0,0,0"
                         VerticalAlignment="Center" Padding="8,4" TextChanged="AlphaPercentInput_TextChanged"/>
            </Grid>
            <!-- RGB 行 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RGB" FontWeight="Medium" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="RInput" Text="255" FontWeight="Medium" Margin="0,0,4,0"
                         VerticalAlignment="Center" Padding="8,4" TextChanged="RgbInput_TextChanged"/>
                <TextBox Grid.Column="2" x:Name="GInput" Text="255" FontWeight="Medium" Margin="0,0,4,0"
                         VerticalAlignment="Center" Padding="8,4" TextChanged="RgbInput_TextChanged"/>
                <TextBox Grid.Column="3" x:Name="BInput" Text="255" FontWeight="Medium" Margin="0,0,4,0"
                         VerticalAlignment="Center" Padding="8,4" TextChanged="RgbInput_TextChanged"/>
                <TextBox Grid.Column="4" x:Name="AlphaInput" Text="100%" FontWeight="Medium" Width="60"
                         VerticalAlignment="Center" Padding="8,4" TextChanged="AlphaInput_TextChanged"/>
            </Grid>
        </StackPanel>

        <!-- 按钮区域 -->
        <Grid Grid.Row="4" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="1" x:Name="CancelButton"
                       Content="{DynamicResource ColorPickerCancel}"
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       Click="CancelButton_Click"/>
            <ui:Button Grid.Column="2" x:Name="ConfirmButton"
                       Content="{DynamicResource ColorPickerConfirm}"
                       Appearance="Primary"
                       Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>