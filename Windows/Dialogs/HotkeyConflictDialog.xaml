<ui:FluentWindow x:Class="CraftSharp.Windows.Dialogs.HotkeyConflictDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource HotkeyConflictTitle}"
                 Height="Auto" MinHeight="0" Width="420" MinWidth="320"
                 WindowStartupLocation="CenterOwner"
                 SizeToContent="Height"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource HotkeyConflictTitle}" ShowMinimize="False" ShowMaximize="False" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <ui:Button HorizontalAlignment="Right"
                       Content="{DynamicResource HotkeyConflictConfirm}"
                       Appearance="Primary"
                       Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
