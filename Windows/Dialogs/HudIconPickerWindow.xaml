<ui:FluentWindow x:Class="CraftSharp.Windows.Dialogs.HudIconPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource HudIconPickerTitle}"
                 Height="360" Width="480" MinHeight="250" MinWidth="300"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource HudIconPickerTitle}" ShowMinimize="False" ShowMaximize="True" ShowClose="True"
                     FontSize="14" FontWeight="Medium" Background="{DynamicResource ApplicationBackgroundBrush}"/>

        <!-- 图标网格 -->
        <Grid Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}">
            <!-- 网格布局（心形、饥饿等） -->
            <ScrollViewer x:Name="GridScrollViewer" Padding="16" VerticalContentAlignment="Center" Visibility="Visible">
                <ItemsControl x:Name="IconGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="64" Height="64" Margin="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="IconItem_Click"
                                    ToolTip="{Binding DisplayName}"
                                    ToolTipService.InitialShowDelay="0"
                                    ToolTipService.ShowDuration="5000">
                                <Grid>
                                    <Image x:Name="IconImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Source="{Binding BitmapImage, TargetNullValue={x:Null}}"/>
                                    <TextBlock x:Name="NoneText" Text="无"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IconStyle}" Value="">
                                    <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="NoneText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 纵向布局（经验条、BOSS血条等） -->
            <ScrollViewer x:Name="VerticalScrollViewer" Padding="16"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Center">
                <ItemsControl x:Name="VerticalIconGrid" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="VerticalItemBorder"
                                    Height="32" Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="{Binding MaxWidth}"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Padding="8,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="IconItem_Click"
                                    ToolTip="{Binding DisplayName}"
                                    ToolTipService.InitialShowDelay="0"
                                    ToolTipService.ShowDuration="5000">
                                <Grid>
                                    <Image x:Name="VerticalIconImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Source="{Binding BitmapImage, TargetNullValue={x:Null}}"/>
                                    <TextBlock x:Name="VerticalNoneText" Text="无"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IconStyle}" Value="">
                                    <Setter TargetName="VerticalIconImage" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="VerticalNoneText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 加载指示器 -->
            <TextBlock x:Name="LoadingOverlay" Text="{DynamicResource IconPickerLoading}"
                       Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
        </Grid>
    </Grid>
</ui:FluentWindow>