<Application x:Class="CraftSharp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <wpfui:ThemesDictionary Theme="Dark" />
                <wpfui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 基础颜色定义 -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#202020"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#999999"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#666666"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#404040"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>